# .env é OPCIONAL e só serve pra conveniência em desenvolvimento nesta máquina
# — uma instalação real distribuída pro restaurante (empacotada, sem esse
# arquivo) roda sem nenhum .env, usando os defaults do GDOOR padrão + o token
# gravado em local_config.json (%APPDATA%\DeliveryHubAgenteGdoor) pela GUI de
# pareamento (parear_gui.py), mesmo padrão do print-agent. Só crie este arquivo
# se precisar sobrepor algo nesta máquina específica (ex.: senha do Firebird
# diferente do padrão, ou apontar pra um server_delivery local em vez do de
# produção).

FB_HOST=127.0.0.1
FB_PORT=3050
FB_DATABASE=C:\GDOOR Sistemas\GDOOR SLIM\DATAGES.FDB
FB_USER=SYSDBA
FB_PASSWORD=
FB_CLIENT_LIBRARY=

VENDAS_SERIE=001
VENDAS_LOJA=0001
VENDAS_CAIXA=0001
VENDAS_OPERADOR=DELIVERY

SQLITE_PATH=./data/sync.db

WEBHOOK_TOKEN=troque-por-um-token-forte

# Só pra apontar pra um server_delivery LOCAL em vez do de produção (dev). Em
# produção não precisa — o padrão já é local_config.DEFAULT_BACKEND_URL.
SERVER_DELIVERY_URL=http://127.0.0.1:3002
# Só pra não precisar reparear pela GUI toda hora enquanto testa nesta máquina.
GDOOR_AGENTE_TOKEN=cole-aqui-o-token-gerado-no-painel
POLLER_INTERVALO_SEG=5
