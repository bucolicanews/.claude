import { Body, Controller, Delete, Get, Param, ParseIntPipe, Patch, Post, Req, UseGuards } from '@nestjs/common';
import { RestaurantOwnerGuard } from '../auth/restaurant-owner.guard';
import { ColaboradoresService } from './colaboradores.service';
import type { AtualizarColaboradorBody, CriarColaboradorBody } from './colaboradores.service';

@Controller('restaurante/colaboradores')
@UseGuards(RestaurantOwnerGuard)
export class RestauranteColaboradoresController {
  constructor(private service: ColaboradoresService) {}

  @Get()
  listar(@Req() req: any) {
    return this.service.listar(req.restaurantId);
  }

  @Post()
  criar(@Body() body: CriarColaboradorBody, @Req() req: any) {
    return this.service.criar(req.restaurantId, body);
  }

  @Patch(':id')
  atualizar(@Param('id', ParseIntPipe) id: number, @Body() body: AtualizarColaboradorBody, @Req() req: any) {
    return this.service.atualizar(id, req.restaurantId, body);
  }

  @Delete(':id')
  remover(@Param('id', ParseIntPipe) id: number, @Req() req: any) {
    return this.service.remover(id, req.restaurantId);
  }
}
