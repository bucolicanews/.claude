import { Body, Controller, Get, Post, Req, UseGuards } from '@nestjs/common';
import { ColaboradorGuard } from '../auth/colaborador.guard';
import { ColaboradorOperacoesService } from './colaborador-operacoes.service';
import type { ItemComandaBody } from '../salao/salao.service';

@Controller('colaborador')
@UseGuards(ColaboradorGuard)
export class ColaboradorController {
  constructor(private service: ColaboradorOperacoesService) {}

  @Get('me')
  me(@Req() req: any) {
    return this.service.me(req.colaboradorRestaurantId, req.colaboradorNome, req.colaboradorSetor);
  }

  @Get('produtos')
  produtos(@Req() req: any) {
    return this.service.produtos(req.colaboradorRestaurantId);
  }

  @Post('caixa/abrir')
  abrirCaixa(@Body() body: { valor_inicial?: number }, @Req() req: any) {
    return this.service.abrirCaixa(req.colaboradorRestaurantId, req.colaboradorNome, req.colaboradorSetor, body.valor_inicial);
  }

  @Post('caixa/fechar')
  fecharCaixa(@Body() body: { dinheiro_contado?: number; permitir_pendencias?: boolean }, @Req() req: any) {
    return this.service.fecharCaixa(req.colaboradorRestaurantId, req.colaboradorSetor, body);
  }

  @Post('venda-direta')
  vendaDireta(
    @Body() body: { itens: ItemComandaBody[]; forma_pagamento: string; valor_recebido?: number },
    @Req() req: any,
  ) {
    return this.service.vendaDireta(req.colaboradorRestaurantId, req.colaboradorSetor, body.itens, body.forma_pagamento, body.valor_recebido);
  }
}
