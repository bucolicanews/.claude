import { CanActivate, ExecutionContext, Injectable, ForbiddenException, UnauthorizedException } from '@nestjs/common';
import { JwtGuard } from './jwt.guard';
import { SupabaseService } from '../supabase/supabase.service';

// Mesma composição de RestaurantOwnerGuard: JwtGuard identifica a conta Supabase
// (Authorization: Bearer), depois este guard resolve o motoboy dono dela e confere
// a sessão única (header x-motoboy-session vs. active_session_id/session_expires_at
// no banco) — isso é o que preserva a trava de 1 dispositivo por vez e o
// "forçar logout" do restaurante mesmo com o JWT do Supabase ainda válido.
@Injectable()
export class MotoboyGuard implements CanActivate {
  constructor(
    private jwtGuard: JwtGuard,
    private supabase: SupabaseService,
  ) {}

  async canActivate(context: ExecutionContext): Promise<boolean> {
    await this.jwtGuard.canActivate(context);

    const request = context.switchToHttp().getRequest();
    const userId: string = request.userId;
    const sessionHeader = request.headers['x-motoboy-session'] as string | undefined;
    if (!sessionHeader) throw new UnauthorizedException('Sessão de motoboy necessária');

    const { data } = await this.supabase.client
      .from('motoboys')
      .select('id, name, is_active, active_session_id, session_expires_at')
      .eq('user_id', userId)
      .maybeSingle();

    if (!data) throw new UnauthorizedException('Esta conta não é de um motoboy');
    if (!data.is_active) throw new ForbiddenException('Conta desativada');

    const sessaoValida =
      data.active_session_id === sessionHeader &&
      !!data.session_expires_at &&
      new Date(data.session_expires_at).getTime() > Date.now();
    if (!sessaoValida) throw new UnauthorizedException('Sessão encerrada. Faça login novamente.');

    request.motoboyId = data.id;
    request.motoboyName = data.name;
    return true;
  }
}
